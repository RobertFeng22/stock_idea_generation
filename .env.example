# Copy this file to .env for local runs (never commit the real .env).
# In GitHub Actions these are provided as repository Secrets instead.

# --- Anthropic (used to analyze transcripts) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model used for analysis. Defaults to a good cost/quality balance.
# Options: claude-opus-4-8 (best), claude-sonnet-4-6 (default), claude-haiku-4-5-20251001 (cheapest)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email (Gmail SMTP) ---
# Your Gmail address that sends the report.
GMAIL_ADDRESS=you@gmail.com
# A Gmail "App Password" (16 chars, NOT your normal password).
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Where to send the weekly report (defaults to GMAIL_ADDRESS if empty).
EMAIL_TO=you@gmail.com

# --- Audio transcription (Deepgram) ---
# Used ONLY when a podcast does not publish its own transcript in the RSS feed.
# Get a key at https://console.deepgram.com (new accounts get $200 free credit).
# If left empty, episodes without an in-feed transcript are skipped (logged).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Skip transcribing episodes longer than this many minutes (0 = no limit).
MAX_TRANSCRIBE_MINUTES=0

# --- Behavior ---
# Only look at episodes published within this many days (matches weekly cadence).
LOOKBACK_DAYS=7
